<div class="toc-links">
  <ul>
    <li>
      <div class="clickable toc-link toc-link-container toc-academy">
        {{#if (eq page.component.title 'TypeDB Academy')}}
        {{#with site.homeUrl}}
            <button class="toc-link-button toc-link-button-academy">{{{ icon "book" }}}</button>
            <a href="{{{ @root.siteRootPath }}}{{{this}}}">TypeDB Docs {{{ icon "arrow-right" }}}</a>
            <span class="toc-link-tooltip">Visit TypeDB Docs for manuals and language reference.</span>
        {{/with}}
        {{else}}
            <button class="toc-link-button toc-link-button-academy">{{{ icon "cap" }}}</button>
            <a href="{{{ @root.siteRootPath }}}{{{ site.components.academy.latest.url }}}">TypeDB Academy {{{ icon "arrow-right" }}}</a>
            <span class="toc-link-tooltip">Visit TypeDB Academy for a more interactive learning experience.</span>
        {{/if}}
      </div>
    </li>
  </ul>
</div>