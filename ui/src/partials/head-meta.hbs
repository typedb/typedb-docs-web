    {{!-- Add additional meta tags here --}}

    {{!-- Prevent indexing on 2.x docs and non-production sites --}}
    {{#if (or (eq page.componentVersion.version "2.x") (ne site.url "https://typedb.com/docs"))}}
      <meta name="robots" content="noindex, nofollow">
    {{/if}}

    {{!-- Advertise the Markdown twin generated by build-llms.js; 2.x and legacy components have none --}}
    {{#unless (or (eq page.componentVersion.version "2.x") (eq page.component.name "manual") (eq page.component.name "drivers") (eq page.component.name "typeql"))}}
      <link rel="alternate" type="text/markdown" href="{{{relativize (mdUrl page.url)}}}" title="Markdown version of this page">
    {{/unless}}
