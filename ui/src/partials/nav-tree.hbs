{{#if navigation.length}}
<ul class="nav-list">
  {{#each navigation}}
  <li
    class="nav-item{{#if (eq ./url @root.page.url)}} is-current-page{{/if}}{{#if ./items.length}} nav-item-expandable{{#if ../expandNav}} is-active{{/if}}{{/if}}"
    data-depth="{{or ../level 0}}"
  >
    {{#if ./content}}
      {{#if ./url}}
        <a class="nav-link" href="{{~#if (eq ./urlType 'internal')}}{{{relativize ./url}}}{{~else}}{{{./url}}}{{~/if}}">
          {{#if (eq ./url @root.page.url)}}<div class="nav-link-active-indicator"></div>{{/if}}
          <p class="nav-text">
            <span>{{{./content}}}</span>
          </p>
        </a>
      {{else}}
        {{#if ./items.length}}
        <button class="nav-text nav-text-toggle">
          <span>{{{./content}}}</span>
          <svg class="nav-text-toggle-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 13.1671L17.4447 7.72237L19 9.27768L12 16.2777L5 9.27768L6.55531 7.72237L12 13.1671Z"/>
          </svg>
        </button>
        {{else}}
        <p class="nav-text">
            <span>{{{./content}}}</span>
        </p>
        {{/if}}
      {{/if}}
    {{/if}}
    {{> nav-tree navigation=./items expandNav=../expandNav level=(increment ../level)}}
  </li>
  {{/each}}
</ul>
{{/if}}
