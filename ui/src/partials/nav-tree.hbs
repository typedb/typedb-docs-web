{{#if navigation.length}}
<ul class="nav-list">
  {{#each navigation}}
  <li
    class="nav-item{{#if (eq ./url @root.page.url)}} is-current-page{{/if}}{{#if ./items.length}} nav-item-expandable{{#if ../expandNav}} is-active{{/if}}{{/if}}"
    data-depth="{{or ../level 0}}"
  >
    {{#if ./content}}
    <div class="nav-text-container">
      {{#if (and ./items.length ../level)}}
      <button class="nav-text-toggle-button">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M13.0913 12L8 6.90867L9.45437 5.4543L16 12L9.45437 18.5457L8 17.0913L13.0913 12Z"/>
        </svg>
      </button>
      {{/if}}
      {{#if ./url}}
      <a class="nav-text nav-link" href="{{~#if (eq ./urlType 'internal')}}{{{relativize ./url}}}{{~else}}{{{./url}}}" target="_blank{{~/if}}">
        <span>{{{./content}}}</span>
        {{#if (ne ./urlType 'internal')}}
        <svg class="nav-external-link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16.6707 8.97635L6.64706 19L5 17.353L15.0237 7.3293H6.1889V5H19V17.8111H16.6707V8.97635Z" />
        </svg>
        {{/if}}
      </a>
      {{else}}
      {{#if (and ./items.length ../level)}}
      <button class="nav-text nav-text-toggle">
        <span>{{{./content}}}</span>
      </button>
      {{else}}
      <p class="nav-text">
        <span>{{{./content}}}</span>
      </p>
      {{/if}}
      {{/if}}
    </div>
    {{/if}}
    {{> nav-tree navigation=./items expandNav=../expandNav level=(increment ../level)}}
  </li>
  {{/each}}
</ul>
{{/if}}
