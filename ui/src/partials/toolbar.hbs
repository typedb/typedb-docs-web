<div class="toolbar-area">
  <nav class="toolbar">
    <button class="nav-toggle-button"></button>
    <p class="nav-item">
      {{#if (findPageVersion site.components.home.versions page.componentVersion.version)}}
        <a class="nav-text nav-link" href="{{{ relativize this.url }}}">
          <span>
            <span class="docs-home-icon"></span>
            <span class="docs-home-text">Docs Home</span>
          </span>
        </a>
      {{/if}}
      {{#unless (findPageVersion site.components.home.versions page.componentVersion.version)}}
        <a class="nav-text nav-link" href="{{{ relativize site.components.home.latest.url }}}">
          <span>
            <span class="docs-home-icon"></span>
            <span class="docs-home-text">Docs Home</span>
          </span>
        </a>
      {{/unless}}
    </p>
    <div class="toolbar-over-article">
      <div class="toolbar-search">
        {{> search}}
      </div>
      <div class="toolbar-explore">
        {{> nav-explore}}
      </div>
    </div>
  </nav>
</div>
