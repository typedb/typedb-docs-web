<div class="toolbar-area">
  <nav class="toolbar">
    <button class="nav-toggle-button"></button>
    <p class="nav-item">
      {{#with (findPageVersion site.components.home.versions page.componentVersion.version)}}
        <a class="nav-text nav-link" href="{{{ relativize this.url }}}">
          <span>
            <span class="docs-home-icon"></span>
            <span class="docs-home-text">Docs Home</span>
          </span>
        </a>
      {{/with}}
    </p>
    <div class="toolbar-search">
      {{> search}}
    </div>
    {{> nav-explore}}
  </nav>
</div>
