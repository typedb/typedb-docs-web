{
  "name": "typedb-web-docs",
  "scripts": {
    "postinstall": "cd ui && pnpm i && cd ..",
    "clean": "rm -rf dist",
    "build-ui": "cd ui && pnpm build && cd ..",
    "build-content": "echo 'Generating site...' && antora antora-playbook.yml",
    "build": "npm run build-ui && npm run build-content",
    "build-llms": "node build-llms.js",
    "prune-sitemap": "node prune-sitemap.js",
    "add-llms-short": "node add-llms-short.js",
    "build-ci": "./build-ci.sh"
  },
  "dependencies": {
    "prismjs": "1.29.0"
  },
  "devDependencies": {
    "@antora/cli": "3.1.5",
    "@antora/lunr-extension": "1.0.0-alpha.8",
    "@antora/site-generator": "3.1.5",
    "@asciidoctor/tabs": "1.0.0-beta.6",
    "@sanity/types": "3.67.1",
    "cheerio": "1.1.2",
    "turndown": "7.2.1",
    "typedb-web-common": "workspace:*",
    "xml2js": "0.6.2"
  },
  "engines": {
    "node": ">=22.16 <23"
  },
  "packageManager": "pnpm@10.12.1+sha256.889bac470ec93ccc3764488a19d6ba8f9c648ad5e50a9a6e4be3768a5de387a3"
